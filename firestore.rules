rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // مدیر را فقط از طریق Firebase Console در admins/{UID} ثبت کنید.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'class', 'username', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.class is string
        && request.resource.data.username is string
        && request.resource.data.status == 'pending';
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.class is string
        && request.resource.data.subject is string
        && request.resource.data.startsAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.overall is number
        && request.resource.data.subjects is list;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}